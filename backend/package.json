{
  "name": "discoversalah-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "worker": "tsx src/workers/run.ts",
    "db:indexes": "tsx scripts/indexes.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "seed:demo": "tsx scripts/seed.ts",
    "env:init": "tsx scripts/init-env.ts",
    "retention": "tsx scripts/retention.ts",
    "retention:replay": "tsx scripts/retention.ts --replay-ledger",
    "worker:start": "node dist/src/workers/run.js",
    "images:cleanup": "tsx scripts/cleanup-notice-images.ts",
    "images:cleanup:start": "node dist/scripts/cleanup-notice-images.js",
    "test": "tsx --test --test-concurrency=1 tests/policies.test.ts tests/integration.test.ts tests/notice-images.test.ts tests/scheduled.test.ts tests/freshness.test.ts",
    "test:images": "tsx --test --test-concurrency=1 tests/notice-images.test.ts",
    "images:check": "tsx scripts/check-notice-images.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests docs *.json *.yml",
    "test:unit": "tsx --test tests/policies.test.ts",
    "admin:setup": "tsx scripts/setup-admin.ts",
    "db:check": "tsx scripts/check-db.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:browser:images": "tsx scripts/browser-notice-images.ts",
    "worker:once": "tsx scripts/run-worker-once.ts",
    "worker:once:start": "node dist/scripts/run-worker-once.js",
    "start:render": "node dist/scripts/indexes.js && node dist/src/server.js"
  },
  "dependencies": {
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "libphonenumber-js": "1.13.15",
    "mongodb": "6.21.0",
    "otpauth": "9.5.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.8.3"
  }
}
